<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Tarot Hybrid Diary</title>

<!-- Rubik font -->
<link href="https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500&display=swap" rel="stylesheet">

<style>
  body {
    background: black;
    color: white;
    font-family: 'Rubik', sans-serif;
    text-align: center;
    margin: 0;
    padding: 0;
  }

  #card-area img {
    width: 100vw;
    max-width: 700px;
    display: block;
    margin: 30px auto;
  }

  #question-box {
    width: 95%;
    max-width: 700px;
    display: block;
    margin: 30px auto;
    padding: 20px;
    font-size: clamp(28px, 8vw, 40px);
    background: #222;
    color: white;
    border: 1px solid #555;
    border-radius: 8px;
  }

  #infinity-btn {
    font-size: clamp(70px, 15vw, 120px);
    display: block;
    margin: 20px auto;
    cursor: pointer;
    background: none;
    border: none;
    color: white;
    padding: 10px;
  }

  /* BOOK BUTTON */
  #diary-btn {
    font-size: clamp(40px, 10vw, 70px);
    margin: 10px auto 30px auto;
    cursor: pointer;
    background: none;
    border: none;
    color: #f5e6c8;
    text-shadow: 0 0 10px #c9a86a;
    transition: transform 0.2s;
  }
  #diary-btn:hover {
    transform: scale(1.15);
  }

  /* DIARY PANEL */
  #diary-panel {
    display: none;
    background: #111;
    padding: 20px;
    text-align: left;
    max-width: 700px;
    margin: 0 auto;
    border-left: 2px solid #444;
    border-right: 2px solid #444;
  }

  .entry {
    background: #1c1c1c;
    padding: 15px;
    margin: 15px 0;
    border: 1px solid #333;
    border-radius: 6px;
  }

  #back-btn {
    font-size: 30px;
    margin: 20px auto;
    display: block;
    background: none;
    border: 1px solid #555;
    color: white;
    padding: 10px 20px;
    border-radius: 6px;
    cursor: pointer;
  }
</style>
</head>

<body>

<input id="question-box" type="text" placeholder="Write your question here">
<button id="infinity-btn">∞</button>

<!-- BOOK BUTTON -->
<button id="diary-btn">📖</button>

<div id="card-area"></div>

<!-- DIARY PANEL -->
<div id="diary-panel"></div>

<script>
let lastQuestion = "";

/* HYBRID RANDOMNESS */
function hybridRandom(question) {
  let sum = 0;

  for (let i = 0; i < question.length; i++) {
    sum += question.charCodeAt(i);
  }

  sum += question.length * 13;
  sum += Date.now() % 100000;
  sum += Math.floor(Math.random() * 9999);

  return (sum % 78) + 1;
}

/* SAVE DIARY ENTRY */
function saveDiaryEntry(question, cardNumber) {
  const entry = {
    question: question,
    card: cardNumber,
    date: new Date().toLocaleString()
  };

  let diary = JSON.parse(localStorage.getItem("tarotDiary") || "[]");
  diary.push(entry);
  localStorage.setItem("tarotDiary", JSON.stringify(diary));
}

/* SHOW CARD */
function showHybridCard(question) {
  const n = hybridRandom(question);
  saveDiaryEntry(question, n);

  const img = new Image();
  img.src = `cards/${n}.png?cb=${Date.now()}`;

  img.onload = () => {
    const area = document.getElementById('card-area');
    area.innerHTML = '';
    area.appendChild(img);
  };
}

/* BUTTON: DRAW CARD ONLY IF QUESTION IS NEW */
document.getElementById('infinity-btn').addEventListener('click', () => {
  const question = document.getElementById('question-box').value.trim();

  if (question !== "" && question !== lastQuestion) {
    lastQuestion = question;
    showHybridCard(question);
  }
});

/* SHOW DIARY */
document.getElementById('diary-btn').addEventListener('click', () => {
  let diary = JSON.parse(localStorage.getItem("tarotDiary") || "[]");
  let html = "<h2>Your Tarot Diary</h2>";

  diary.forEach(entry => {
    html += `
      <div class="entry">
        <p><strong>Question:</strong> ${entry.question}</p>
        <p><strong>Card:</strong> ${entry.card}</p>
        <p><strong>Date:</strong> ${entry.date}</p>
      </div>
    `;
  });

  html += `<button id="back-btn">Back</button>`;

  document.getElementById('diary-panel').innerHTML = html;
  document.getElementById('diary-panel').style.display = "block";
  document.getElementById('card-area').style.display = "none";
});

/* BACK BUTTON */
document.addEventListener('click', (e) => {
  if (e.target.id === "back-btn") {
    document.getElementById('diary-panel').style.display = "none";
    document.getElementById('card-area').style.display = "block";
  }
});
</script>

</body>
</html>
